{
  "manifest_version": 2,
  "name": "firefox-copy-rich-link",
  "version": "1.0.0",
  "description": "Places a button inside the address bar to copy the page link as rich text (for MS Teams, Outlook, Word) and Markdown.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-copy-rich-link@andre.local"
    }
  },
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "page_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Copy Rich Link (Alt+Shift+C)",
    "show_matches": ["<all_urls>"]
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "_execute_page_action": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "windows": "Alt+Shift+C"
      },
      "description": "Copy Rich Link"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png"
  }
}
